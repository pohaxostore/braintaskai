/*==================================================
    BraintaskAI
    HERO
==================================================*/

/*==============================
    HERO SECTION
==============================*/

#hero{

    min-height:100vh;

    display:flex;

    align-items:center;

    padding-top:170px;

    padding-bottom:100px;

}

.hero-content{

    display:grid;

    grid-template-columns:1.1fr .9fr;

    align-items:center;

    gap:90px;

}

/*==============================
    HERO LEFT
==============================*/

.hero-left{

    position:relative;

}

.hero-left h1{

    font-size:clamp(3rem,7vw,5.5rem);

    line-height:1;

    font-weight:800;

    letter-spacing:-3px;

    margin:30px 0;

}

.hero-left h1 span{

    background:var(--gradient-primary);

    -webkit-background-clip:text;

    -webkit-text-fill-color:transparent;

}

.hero-left p{

    max-width:600px;

    font-size:1.15rem;

    margin-bottom:45px;

    color:var(--text-light);

}

/*==============================
    BUTTONS
==============================*/

.hero-buttons{

    display:flex;

    gap:18px;

    flex-wrap:wrap;

    margin-bottom:55px;

}

/*==============================
    STATS
==============================*/

.hero-stats{

    display:flex;

    gap:50px;

    flex-wrap:wrap;

}

.hero-stats h2{

    font-size:2.2rem;

    margin-bottom:6px;

}

.hero-stats span{

    color:var(--text-light);

}
/*==============================
    HERO RIGHT
==============================*/

.hero-right{

    position:relative;

    display:flex;

    justify-content:center;

    align-items:center;

}

/*==============================
    DASHBOARD
==============================*/

.dashboard{

    width:100%;

    max-width:500px;

    padding:28px;

}

.dashboard-top{

    display:flex;

    gap:10px;

    margin-bottom:25px;

}

.circle{

    width:14px;

    height:14px;

    border-radius:50%;

}

.red{

    background:#EF4444;

}

.yellow{

    background:#F59E0B;

}

.green{

    background:#10B981;

}

/*==============================
    CHART
==============================*/

.chart{

    display:flex;

    align-items:flex-end;

    justify-content:space-between;

    gap:12px;

    height:220px;

    margin-bottom:30px;

}

.bar{

    flex:1;

    border-radius:14px 14px 0 0;

    background:var(--gradient-primary);

    animation:bars 2.5s ease-in-out infinite alternate;

}

.bar1{

    height:45%;

}

.bar2{

    height:70%;

}

.bar3{

    height:90%;

}

.bar4{

    height:60%;

}

.bar5{

    height:100%;

}

.dashboard-card{

    padding:22px;

    border-radius:20px;

    background:rgba(255,255,255,.75);

    backdrop-filter:blur(12px);

}

.dashboard-card h3{

    margin-bottom:12px;

}

.dashboard-card h2{

    font-size:2.5rem;

    color:var(--primary);

    margin-bottom:8px;

}
/*==============================
    FLOATING CARDS
==============================*/

.floating-card{

    position:absolute;

    padding:14px 20px;

    border-radius:18px;

    background:white;

    box-shadow:var(--shadow-md);

    font-weight:700;

    animation:float 5s ease-in-out infinite;

}

.card-one{

    top:40px;

    left:-30px;

}

.card-two{

    right:-35px;

    top:180px;

    animation-delay:1.5s;

}

.card-three{

    bottom:20px;

    left:20px;

    animation-delay:3s;

}

/*==============================
    ANIMATIONS
==============================*/

@keyframes float{

    0%{

        transform:translateY(0);

    }

    50%{

        transform:translateY(-15px);

    }

    100%{

        transform:translateY(0);

    }

}

@keyframes bars{

    from{

        transform:scaleY(.75);

    }

    to{

        transform:scaleY(1);

    }

}
/*==============================
    HERO NOTICE
==============================*/

.hero-notice{

    display:inline-flex;

    align-items:center;

    gap:12px;

    padding:10px 18px;

    background:rgba(255,255,255,.75);

    backdrop-filter:blur(15px);

    border:1px solid rgba(124,58,237,.15);

    border-radius:999px;

    margin-bottom:25px;

    font-size:.92rem;

    font-weight:600;

    color:var(--text);

    box-shadow:var(--shadow-sm);

}

.live-dot{

    width:10px;

    height:10px;

    border-radius:50%;

    background:#22C55E;

    animation:pulse 1.8s infinite;

}

@keyframes pulse{

    0%{

        box-shadow:0 0 0 0 rgba(34,197,94,.6);

    }

    70%{

        box-shadow:0 0 0 10px rgba(34,197,94,0);

    }

    100%{

        box-shadow:0 0 0 0 rgba(34,197,94,0);

    }

}
/*==============================
    DASHBOARD HEADER
==============================*/

.dashboard-header{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:20px;

}

.dashboard-header h3{

    font-size:1rem;

}

.dashboard-header span{

    background:#DCFCE7;

    color:#16A34A;

    padding:6px 12px;

    border-radius:999px;

    font-size:.8rem;

    font-weight:700;

}

/*==============================
    DASHBOARD STATS
==============================*/

.dashboard-stats{

    display:grid;

    grid-template-columns:1fr 1fr;

    gap:15px;

    margin-bottom:25px;

}

.dashboard-stats div{

    padding:18px;

    background:rgba(255,255,255,.6);

    border-radius:16px;

    border:1px solid rgba(226,232,240,.8);

}

.dashboard-stats h4{

    font-size:.9rem;

    color:var(--text-light);

    margin-bottom:8px;

}

.dashboard-stats strong{

    font-size:1.4rem;

    color:var(--dark);

}
/*==============================
    NOTIFICATION CARD
==============================*/

.notification-card{

    position:absolute;

    top:-20px;

    right:-40px;

    display:flex;

    align-items:center;

    gap:15px;

    padding:18px;

    width:260px;

    background:rgba(255,255,255,.9);

    backdrop-filter:blur(20px);

    border-radius:20px;

    box-shadow:var(--shadow-lg);

    animation:float 6s ease-in-out infinite;

}

.notification-icon{

    width:52px;

    height:52px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:16px;

    background:var(--gradient-primary);

    color:white;

    font-size:1.3rem;

}

.notification-card strong{

    display:block;

    margin-bottom:4px;

}

.notification-card p{

    font-size:.9rem;

    color:var(--text-light);

}

